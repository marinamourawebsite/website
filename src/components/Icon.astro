---
// Icon.astro — inlines SVG markup from a fixed whitelist (lucide + brand marks).
// The whitelist is the union of the `select` options in public/admin/config.yml.
// Adding an icon means: add its inner markup here, add the option in config.yml,
// and update the icon enums in src/content.config.ts.
//
// Sourcing notes (updated in Phase 5):
//   - Outline tier: lucide, 24x24 viewBox, fill="none" stroke="currentColor" stroke-width="2".
//     Every outline icon maps 1:1 to the same-named lucide icon.
//   - Brand tier (`brandIcons`): filled glyphs from Simple Icons (CC0-1.0), same 24x24
//     viewBox, rendered fill="currentColor" with NO stroke. A filled path must never
//     inherit stroke-width="2" — it bloats the glyph visibly.
//   - `linkedin` is the only brand glyph whose geometry is modified: the official mark's
//     background plate subpath is removed, leaving the bare "in". Human-approved; see the
//     inline comment on the entry before touching it.
//   - `whatsapp` is a hybrid: Simple Icons ships no outline version, so the official
//     path is split by subpath — the handset is filled, the bubble contour is stroked at
//     2px. This matches design/reference.png, which shows an outline bubble with a solid
//     handset. Geometry is the official one, only the paint differs.
// Brand marks (Instagram, TikTok, LinkedIn, WhatsApp) are trademarks of their respective
// owners, used nominatively here to link to the corresponding profiles.

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

// name -> inner SVG markup (paths/shapes only), rendered with the lucide outline paint.
const icons: Record<string, string> = {
  instagram:
    '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>',
  // whatsapp -> official Simple Icons geometry, split by subpath: filled handset (first
  // subpath, painted locally) + stroked inner bubble contour incl. the bottom-left tail.
  whatsapp:
    '<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347" fill="currentColor" stroke="none"/><path d="M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/>',
  mail:
    '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  video:
    '<path d="m22 8-6 4 6 4V8Z"/><rect width="14" height="12" x="2" y="6" rx="2" ry="2"/>',
  smartphone:
    '<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>',
  ticket:
    '<path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 11v2"/><path d="M13 17v2"/>',
  handshake:
    '<path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/>',
  lightbulb:
    '<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
  folder:
    '<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>',

  // --- UI decoration tier (NOT content icons) ---
  // These are chrome, not CMS-selectable. Per Planner ruling on CLAUDE.md rule 5,
  // they must NOT appear in any config.yml select nor the src/content.config.ts
  // icon enums. Used directly by components (hero chevron, service-card chevron).
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  'chevron-right': '<path d="m9 18 6-6-6-6"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  heart:
    '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.5 4.04 3 5.5l7 7Z"/>',
  download:
    '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>',
  'arrow-right': '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
};

// --- Brand tier: official Simple Icons glyphs, rendered FILLED with no stroke. ---
// Same whitelist contract as `icons`; only the paint differs. Names must stay unique
// across both maps.
const brandIcons: Record<string, string> = {
  // linkedin -> the official Simple Icons LinkedIn glyph WITH THE BACKGROUND PLATE
  // SUBPATH REMOVED. Upstream, the mark is four subpaths in the order `n`, dot, `i`-stem,
  // plate; the plate begins at `M22.225 0H1.771` and everything from there on is dropped.
  // This is deliberate and human-approved (fix round 1): design/reference.png draws a
  // solid, plate-less "in", and the upstream glyph renders as a black square inside the
  // 44px chip. DO NOT "restore" this path from upstream Simple Icons — that silently
  // reintroduces the plate. See docs/phases/phase-5-brief-fix1.md.
  linkedin:
    '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"/>',
  tiktok:
    '<path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>',
};

const filled = name in brandIcons;
const markup = filled ? brandIcons[name] : icons[name];
if (!markup) {
  throw new Error(
    `Icon "${name}" is not in the whitelist. Allowed: ${[...Object.keys(icons), ...Object.keys(brandIcons)].join(', ')}`,
  );
}

// Filled glyphs must not inherit the outline tier's stroke — it bloats the shape.
const paint = filled
  ? { fill: 'currentColor', stroke: 'none' }
  : {
      fill: 'none',
      stroke: 'currentColor',
      'stroke-width': 2,
      'stroke-linecap': 'round',
      'stroke-linejoin': 'round',
    };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  {...paint}
  aria-hidden="true"
  class={className}
  set:html={markup}
/>
