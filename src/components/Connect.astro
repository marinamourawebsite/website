---
// Connect — "· VAMOS NOS CONECTAR ·" (SPEC §3.4).
// Centered flex-wrap of 5 square outlined cards; whole card is a link.
// All copy from connect.json (rule 2).
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import SectionLabel from './SectionLabel.astro';

const connect = (await getEntry('connect', 'data'))!.data;

// mailto: links stay same-tab and get no rel; everything else opens externally.
const external = (url: string) => !url.startsWith('mailto:');
---

<section
  id="conectar"
  aria-label={connect.sectionLabel}
  class="mt-12 scroll-mt-8 sm:mt-16"
>
  <SectionLabel label={connect.sectionLabel} />

  <ul class="mt-6 flex flex-wrap justify-center gap-3 sm:gap-4">
    {
      connect.items.map((item) => (
        <li>
          <a
            href={item.url}
            {...(external(item.url)
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
            class="flex h-[92px] w-[104px] flex-col items-center justify-center gap-2.5 rounded-[14px] border border-line bg-surface text-ink shadow-sm transition-shadow hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage"
          >
            <Icon name={item.icon} size={24} />
            <span class="text-[0.65rem] font-medium uppercase tracking-[0.12em]">
              {item.label}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
